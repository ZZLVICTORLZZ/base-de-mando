    "version": "1.0.0",
    "scheme": "app-motor-j2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.basedemando.j2",
      "versionCode": 1,
      "adaptiveIcon": {
