{
  "expo": {
    "name": "app-motor-j2",
    "slug": "app-motor-j2",
    "version": "1.0.0",
    "scheme": "app-motor-j2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basedemando.j2",
      "infoPlist": {
        "NSCameraUsageDescription": "La aplicación J2 requiere acceso a la cámara para escanear códigos QR de unidades y tomar fotografías de evidencia operativa.",
        "NSPhotoLibraryUsageDescription": "La aplicación J2 requiere acceso a la galería para adjuntar y exportar reportes operativos.",
        "NSPhotoLibraryAddUsageDescription": "La aplicación J2 requiere permiso para guardar capturas y reportes operativos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.basedemando.j2",
      "versionCode": 2,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Motor J2",
      "shortName": "Motor J2",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#006847",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-audio",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cd014c4-8d70-4283-803f-56893682fef6"
      }
    },
    "owner": "zzvictorzz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2cd014c4-8d70-4283-803f-56893682fef6"
    }
  }
}
